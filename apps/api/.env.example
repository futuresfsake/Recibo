# Copy to apps/api/.env (gitignored). Nothing here is required to start the API.
PORT=8000
CORS_ORIGIN=http://localhost:5173

# Postgres is optional (dev/eval only). Leave the password empty to skip the DB check.
# If set, it must match POSTGRES_PASSWORD in the root .env used by docker-compose.
POSTGRES_USER=resibo
POSTGRES_PASSWORD=
POSTGRES_DB=resibo
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b
EMBED_MODEL=nomic-embed-text
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
CITATION_MATCH_THRESHOLD=90
