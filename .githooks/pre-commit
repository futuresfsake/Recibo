#!/bin/sh
# Resibo pre-commit: block secrets and env files, protect the audit log.
staged=$(git diff --cached --name-only --diff-filter=ACM)

# 1. never commit real env files (the example is allowed)
echo "$staged" | grep -E '(^|/)\.env($|\.)' | grep -v '\.env\.example$' && {
  echo "BLOCKED: .env file staged. Only .env.example may be committed."; exit 1; }

# 2. gitleaks if installed, otherwise a simple pattern scan
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --redact -c .gitleaks.toml || exit 1
else
  if git diff --cached -U0 | grep -E '^\+' | grep -E 'sk-[A-Za-z0-9]{20,}|AKIA[0-9A-Z]{16}|gsk_[A-Za-z0-9]{20,}|AIza[0-9A-Za-z_-]{35}|-----BEGIN [A-Z ]*PRIVATE KEY-----'; then
    echo "BLOCKED: possible secret in staged changes."; exit 1
  fi
fi

# 3. audit log is append-only: removed lines are not allowed
if git diff --cached --numstat -- docs/audit/log.jsonl | awk '$2 > 0 {bad=1} END {exit !bad}'; then
  echo "BLOCKED: docs/audit/log.jsonl is append-only (lines were removed or edited)."; exit 1
fi
exit 0
