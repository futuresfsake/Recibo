#!/bin/sh
# Resibo pre-push: tests (if present) and requirement traceability.
if [ -d backend/tests ] && ls backend/tests/test_*.py >/dev/null 2>&1; then
  (cd backend && python -m pytest -q --junitxml=../.pytest-junit.xml) || { echo "BLOCKED: tests failed."; exit 1; }
fi
python scripts/trace.py || { echo "BLOCKED: traceability check failed."; exit 1; }
exit 0
