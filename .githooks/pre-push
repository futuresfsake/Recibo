#!/bin/sh
# Resibo pre-push: tests (if present) and requirement traceability.
PY=python
[ -x backend/.venv/Scripts/python.exe ] && PY="$(pwd)/backend/.venv/Scripts/python.exe"
[ -x backend/.venv/bin/python ] && PY="$(pwd)/backend/.venv/bin/python"
if ls backend/tests/test_*.py >/dev/null 2>&1; then
  (cd backend && "$PY" -m pytest -q) || { echo "BLOCKED: tests failed."; exit 1; }
fi
"$PY" scripts/trace.py || { echo "BLOCKED: traceability check failed."; exit 1; }
exit 0
