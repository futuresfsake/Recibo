{
  "name": "resibo",
  "private": true,
  "version": "0.2.0",
  "description": "Evidence-grounded resume-job matching for the Philippine job market.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "run-p dev:api dev:web",
    "dev:api": "npm run dev -w @resibo/api",
    "dev:web": "npm run dev -w @resibo/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "trace": "node scripts/trace.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run trace"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "npm-run-all2": "^8.0.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
